@model LoginInputModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log in - FactFlow</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <div class="login-window">
        <div class="login-titlebar">LOG IN</div>
        <div class="login-panel">
            <partial name="_SystemLogo" />
            <div class="login-product-type">FACTFLOW SYSTEM</div>
            <div class="login-product-name">FACTFLOW</div>
            <form asp-controller="Account" asp-action="Login" method="post" class="login-form">
                <input asp-for="ReturnUrl" type="hidden" />
                <div class="field">
                    <label asp-for="Username">Username</label>
                    <input asp-for="Username" autocomplete="username" autofocus />
                    <span asp-validation-for="Username"></span>
                </div>
                <div class="field">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" autocomplete="current-password" />
                    <span asp-validation-for="Password"></span>
                </div>
                <div asp-validation-summary="ModelOnly" class="login-error"></div>
                <button type="submit" class="login-button">Log in to account</button>
            </form>
            <div class="login-help"><span>Forgot your password?</span> Contact administrator</div>
        </div>
    </div>
</body>
</html>
