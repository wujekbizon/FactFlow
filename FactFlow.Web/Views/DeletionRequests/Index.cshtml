@model DeletionRequestQueueSnapshot
@using FactFlow.Application.Security
@using FactFlow.Domain.CatFacts
@using FactFlow.Web.Workspaces
@inject IWorkspaceTabService WorkspaceTabs
@{
    ViewData["Title"] = Model.IsSupervisor ? "Action approvals" : "My requests";
}

<div class="page-title">
    <div>
        <h1>@(Model.IsSupervisor ? "Action approvals" : "My requests")</h1>
        <p>@(Model.IsSupervisor ? "Supervisor decisions for destructive operations." : "Track your requested fact deletions.")</p>
    </div>
    <span class="record-total">@Model.PendingCount pending</span>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="message success" role="status"><span>✓</span>@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="message error" role="alert"><span>!</span>@errorMessage</div>
}

<div class="summary-cards review-summary">
    <a class="summary-card" asp-action="Index" asp-route-status="Pending"><span>Pending</span><strong>@Model.PendingCount</strong></a>
    <a class="summary-card" asp-action="Index" asp-route-status="Approved"><span>Approved</span><strong>@Model.ApprovedCount</strong></a>
    <a class="summary-card" asp-action="Index" asp-route-status="Rejected"><span>Rejected</span><strong>@Model.RejectedCount</strong></a>
    <a class="summary-card" asp-action="Index" asp-route-status="Expired"><span>Expired</span><strong>@Model.ExpiredCount</strong></a>
</div>

<section class="medical-card queue-card">
    <header class="card-header"><h2>Deletion requests</h2><span class="card-count">@(Model.SelectedStatus ?? "All statuses")</span></header>
    <form asp-action="Index" method="get" class="queue-filters">
        <select name="status" aria-label="Request status">
            <option value="">All statuses</option>
            @foreach (var status in Enum.GetValues<FactDeletionRequestStatus>())
            {
                <option value="@status" selected="@(status.ToString() == Model.SelectedStatus ? "selected" : null)">@status</option>
            }
        </select>
        <button class="secondary-button" type="submit">Apply filter</button>
        <a class="secondary-button" asp-action="Index">Clear</a>
    </form>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-table">No deletion requests found.</div>
    }
    else
    {
        <div class="table-scroll">
            <table class="queue-table approval-table">
                <thead><tr><th>ID</th><th>Fact snapshot</th><th>Requester</th><th>Reason</th><th>Status</th><th>Requested</th><th>Decision</th></tr></thead>
                <tbody>
                @foreach (var request in Model.Items)
                {
                    <tr>
                        <td>#@request.Id</td>
                        <td>@request.FactContentSnapshot</td>
                        <td>@request.RequestedBy</td>
                        <td>@request.Reason</td>
                        <td><span class="state-badge state-@request.Status.ToLowerInvariant()">@request.Status</span></td>
                        <td>@request.RequestedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (Model.IsSupervisor && request.Status == nameof(FactDeletionRequestStatus.Pending))
                            {
                                <div class="approval-actions">
                                    <button class="row-action-approve" type="button"
                                            data-decision-trigger
                                            data-decision="approve"
                                            data-request-id="@request.Id"
                                            data-fact="@request.FactContentSnapshot"
                                            data-action-url="@Url.Action("Approve", "DeletionRequests")">
                                        Approve
                                    </button>
                                    <button class="row-action-reject" type="button"
                                            data-decision-trigger
                                            data-decision="reject"
                                            data-request-id="@request.Id"
                                            data-fact="@request.FactContentSnapshot"
                                            data-action-url="@Url.Action("Reject", "DeletionRequests")">
                                        Reject
                                    </button>
                                </div>
                            }
                            else if (request.DecidedBy is not null)
                            {
                                <div class="request-decision">
                                    <strong>@request.DecidedBy</strong>
                                    <span>@(request.DecidedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</span>
                                    @if (!string.IsNullOrWhiteSpace(request.DecisionNote))
                                    {
                                        <span>@request.DecisionNote</span>
                                    }
                                </div>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.IsSupervisor)
{
    <dialog class="decision-modal" data-decision-modal aria-labelledby="decision-modal-title">
        <form asp-controller="DeletionRequests" asp-action="Approve" method="post" class="decision-modal-panel" data-decision-form>
            <input name="RequestId" type="hidden" data-decision-request-id />
            <input name="TabId" value="@WorkspaceTabs.ActiveTabId" type="hidden" />

            <header class="decision-modal-header">
                <div>
                    <span class="decision-modal-eyebrow">Supervisor decision</span>
                    <h2 id="decision-modal-title" data-decision-title>Confirm decision</h2>
                </div>
                <button type="button" class="decision-modal-close" data-decision-close aria-label="Close">×</button>
            </header>

            <div class="decision-modal-body">
                <div class="decision-fact-preview">
                    <small data-decision-request-label>Request</small>
                    <p data-decision-fact></p>
                </div>
                <div class="form-field">
                    <label for="decision-note" data-decision-note-label>Decision note</label>
                    <textarea id="decision-note" name="Note" rows="5" maxlength="1000" data-decision-note></textarea>
                    <div class="field-footer">
                        <span data-decision-validation></span>
                        <span><strong data-decision-character-count>0</strong> / 1000</span>
                    </div>
                </div>
            </div>

            <footer class="decision-modal-footer">
                <button type="button" class="secondary-button" data-decision-close>Cancel</button>
                <button type="submit" class="decision-confirm-button" data-decision-confirm>Confirm</button>
            </footer>
        </form>
    </dialog>
}
