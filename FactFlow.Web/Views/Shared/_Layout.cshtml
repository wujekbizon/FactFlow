@using FactFlow.Web.Workspaces
@inject IWorkspaceTabService WorkspaceTabs
@{
    var openTabs = WorkspaceTabs.GetOpenTabs();
    var activeTabId = WorkspaceTabs.ActiveTabId;
    var activeTab = openTabs.FirstOrDefault(tab => tab.Id == activeTabId) ?? openTabs[0];
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="FactFlow Cat Fact collector" />
    <title>@ViewData["Title"] - FactFlow</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="medical-shell">
        <aside class="medical-sidebar">
            <div class="sidebar-identity">
                <partial name="_SystemLogo" />
                <div class="system-name">FactFlow System</div>
                <div class="system-version">v1.0</div>
            </div>

            <nav class="command-menu" aria-label="Main navigation">
                <div class="command-section">
                    <div class="command-section-title">CAT FACTS</div>
                    <a class="command-item @(activeTab.Kind == "Dashboard" ? "active" : null)" asp-controller="Home" asp-action="Index">
                        <span class="command-icon">⌂</span><span>Dashboard</span>
                    </a>
                    <a class="command-item @(activeTab.Kind == "NewFact" ? "active" : null)" asp-controller="Facts" asp-action="Create">
                        <span class="command-icon">＋</span><span>New fact</span>
                    </a>
                    <a class="command-item @(activeTab.Kind == "History" ? "active" : null)" asp-controller="Facts" asp-action="History">
                        <span class="command-icon">≡</span><span>Response history</span>
                    </a>
                </div>
            </nav>

            <div class="user-card">
                <div class="user-avatar" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 8a7 7 0 0 0-14 0" /></svg>
                </div>
                <div class="user-details"><strong>@User.Identity?.Name</strong><span>Signed in</span></div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="logout-button" type="submit" title="Log out" aria-label="Log out">
                        <svg viewBox="0 0 24 24"><path d="M10 5H5v14h5M14 8l4 4-4 4M8 12h10" /></svg>
                    </button>
                </form>
            </div>
        </aside>

        <section class="medical-workspace">
            <div class="workspace-frame">
                <div class="tab-strip">
                    @foreach (var workspace in openTabs)
                    {
                        <div class="workspace-tab @(workspace.Id == activeTabId ? "active" : null)">
                            <a class="tab-label"
                               asp-controller="@workspace.Controller"
                               asp-action="@workspace.Action"
                               asp-route-tabId="@(workspace.Id == "dashboard" ? null : workspace.Id)">
                                <span></span>@workspace.Title
                            </a>
                            @if (workspace.IsClosable)
                            {
                                <form asp-controller="Workspace" asp-action="Close" method="post" class="tab-close-form" data-close-workspace="@workspace.Id">
                                    <input type="hidden" name="tabId" value="@workspace.Id" />
                                    <button class="tab-close" type="submit" title="Close tab" aria-label="Close @workspace.Title tab">×</button>
                                </form>
                            }
                        </div>
                    }
                </div>
                <main class="workspace-content" role="main">@RenderBody()</main>
            </div>
            <footer class="medical-statusbar">
                <span class="ready-state"><span>✓</span>Ready</span>
                <span>Open tabs: @openTabs.Count</span>
            </footer>
        </section>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
